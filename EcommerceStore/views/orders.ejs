<%- include('partials/header') %>
<h1>My orders</h1>
<% if (orders.length === 0) { %>
  <p class="empty">You have not placed any orders yet. <a href="/">Start shopping</a></p>
<% } else { %>
<table class="table">
  <thead><tr><th>Order</th><th>Date</th><th>Status</th><th>Total</th><th></th></tr></thead>
  <tbody>
  <% orders.forEach(o => { %>
    <tr>
      <td>#<%= o.id %></td>
      <td><%= o.created_at %></td>
      <td><%= o.status %></td>
      <td>$<%= o.total.toFixed(2) %></td>
      <td><a href="/orders/<%= o.id %>">View</a></td>
    </tr>
  <% }) %>
  </tbody>
</table>
<% } %>
<%- include('partials/footer') %>
