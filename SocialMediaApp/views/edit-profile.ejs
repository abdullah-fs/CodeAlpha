<%- include('partials/header') %>
<div class="auth">
  <h1>Edit profile</h1>
  <% if (error) { %><p class="alert"><%= error %></p><% } %>
  <form action="/settings/profile" method="post" class="form">
    <label>Name <input type="text" name="name" value="<%= user.name %>" maxlength="50" required></label>
    <label>Bio <textarea name="bio" rows="3" maxlength="160" placeholder="A short line about you"><%= user.bio %></textarea></label>
    <button class="btn" type="submit">Save changes</button>
  </form>
</div>
<%- include('partials/footer') %>
